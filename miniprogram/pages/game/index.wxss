page{background:#08161d;color:#eaf7f3;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.page{min-height:100vh;padding:22rpx 22rpx 40rpx;background:radial-gradient(ellipse at 50% -15%,#1a4547 0,#0b242a 42%,#08161d 76%);box-sizing:border-box}.topbar{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.brand{display:flex;align-items:center;gap:16rpx}.brand-icon{width:82rpx;height:82rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #365e5d;border-radius:25rpx;background:#153b39;font-size:43rpx}.eyebrow{font-size:18rpx;letter-spacing:4rpx;color:#73e0c1}.brand-title{font-size:34rpx;font-weight:750;margin-top:3rpx;letter-spacing:1rpx}.restart{border:1rpx solid #25434b;border-radius:19rpx;background:#10232a;padding:17rpx 20rpx;color:#c7d9d6;font-size:22rpx}.intro{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:37rpx 0 26rpx}.intro-title{font-size:43rpx;line-height:1.2;font-weight:780}.intro-desc{color:#89a7a8;font-size:23rpx;line-height:1.65;margin-top:12rpx}.hero-plane{font-size:73rpx;color:#73e0c1;transform:rotate(-24deg);padding:0 13rpx;filter:drop-shadow(0 10rpx 18rpx #55dcbd40)}.scorebar{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:11rpx;padding:18rpx 18rpx;margin-bottom:20rpx;border:1rpx solid #25434b;border-radius:27rpx;background:#0d2027d9}.player{display:flex;align-items:center;gap:12rpx;min-width:0}.player.right{justify-content:flex-end;text-align:right}.avatar{display:flex;align-items:center;justify-content:center;width:66rpx;height:66rpx;flex:none;border-radius:21rpx;background:#1b343c;color:#a5c5c5;font-weight:800;font-size:23rpx}.player.active .avatar{background:#15483d;color:#73e0c1;box-shadow:0 0 0 2rpx #438573}.player-name{font-size:22rpx;font-weight:700;white-space:nowrap}.player-note{margin-top:6rpx;color:#89a7a8;font-size:18rpx;white-space:nowrap}.score{font-variant-numeric:tabular-nums;font-size:31rpx;font-weight:800;color:#ffc978;white-space:nowrap}.score text{font-size:17rpx;color:#89a7a8;font-weight:500}.board-card,.side-card{border:1rpx solid #25434b;border-radius:30rpx;background:linear-gradient(155deg,#122a31f2,#0e2026f5);box-shadow:0 14rpx 45rpx #0002}.board-card{padding:22rpx 14rpx 19rpx}.board-head{display:flex;justify-content:space-between;align-items:center;gap:12rpx;margin:0 5rpx 20rpx}.board-title{font-size:25rpx;font-weight:700}.turn-pill{padding:10rpx 15rpx;border:1rpx solid #3b6361;border-radius:999rpx;background:#123c37;color:#73e0c1;font-size:19rpx;white-space:nowrap}.grid-frame{width:690rpx;max-width:100%;margin:0 auto;display:grid;grid-template-columns:32rpx 1fr;grid-template-rows:26rpx 1fr}.col-axis{grid-column:2;grid-row:1;display:grid;grid-template-columns:repeat(12,1fr);color:#658382;font-size:16rpx;text-align:center;align-items:center}.row-axis{grid-column:1;grid-row:2;display:grid;grid-template-rows:repeat(12,1fr);color:#658382;font-size:15rpx;text-align:center;align-items:center}.board{grid-column:2;grid-row:2;width:100%;aspect-ratio:1;overflow:hidden;border:1rpx solid #498078;border-radius:13rpx;background:#101d22;display:flex;flex-direction:column}.board-row{display:flex;flex:1;min-height:0}.cell{position:relative;display:flex;align-items:center;justify-content:center;flex:1;min-width:0;min-height:0;border-right:1rpx solid #29454b;border-bottom:1rpx solid #29454b;background:linear-gradient(145deg,#1b343a,#152c32);color:#fff;font-size:24rpx;font-weight:900;padding:0;box-sizing:border-box}.cell-miss{background:#0b191e}.cell-miss:after{content:"";width:27%;height:27%;border:2rpx solid #8cb3b1;border-radius:50%}.cell-hit{background:#392b35;color:#ff7380;border-color:#b74f61;text-shadow:0 0 10rpx #ff5269}.cell-explosion{z-index:1;background:#7a302b;border-color:#ffae78;box-shadow:inset 0 0 16rpx #ff6335aa;animation:explode .6s ease-out 2;font-size:36rpx}.cell-wreck{background:linear-gradient(145deg,#344641,#283a38);border-color:#779487;color:#d5dfd2}.cell-wreck.wreck-wing{color:#ced5c2}.cell-wreck.wreck-tail{color:#f1dba7}.board-caption{display:flex;justify-content:space-between;gap:8rpx;margin:17rpx 6rpx 0;color:#89a7a8;font-size:17rpx;line-height:1.5}.info-row{display:flex;gap:14rpx;margin-top:17rpx}.side-card{padding:20rpx;flex:1;min-width:0}.card-title{margin-bottom:15rpx;font-size:21rpx;font-weight:700}.fleet-row{display:flex;align-items:center;justify-content:space-between;padding:14rpx 0;border-top:1rpx solid #213a40;color:#b5cbc7;font-size:20rpx}.fleet-row:first-of-type{border-top:0}.fleet-icons{display:flex;gap:9rpx}.plane-icon{color:#73e0c1;font-size:26rpx}.plane-icon.down{filter:grayscale(1);opacity:.25}.hint{color:#89a7a8;font-size:18rpx;line-height:1.7;margin-top:10rpx}.rule{display:flex;align-items:center;gap:12rpx;margin:16rpx 0;color:#b8ceca;font-size:19rpx}.rule-icon{width:40rpx;height:40rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #34534f;border-radius:12rpx;background:#17332f;color:#73e0c1;font-size:21rpx;font-weight:900}.rule-icon.red{color:#ff6272;border-color:#694450;background:#34232d}.rule-icon.hollow{width:19rpx;height:19rpx;margin:0 11rpx;border:2rpx solid #92b5ae;border-radius:50%;background:transparent}.footer{text-align:center;padding-top:23rpx;color:#617e7e;font-size:17rpx;line-height:1.6}.overlay{position:fixed;z-index:10;inset:0;display:flex;align-items:center;justify-content:center;padding:38rpx;background:#061218ed}.dialog{width:100%;max-width:590rpx;padding:49rpx 39rpx;border:1rpx solid #315457;border-radius:42rpx;background:linear-gradient(150deg,#16353a,#10242b);text-align:center;box-shadow:0 22rpx 90rpx #0008;box-sizing:border-box}.dialog-icon{font-size:88rpx;line-height:1;margin-bottom:27rpx}.dialog-title{margin:13rpx 0;font-size:48rpx;font-weight:800}.dialog-text{margin:0 auto 37rpx;max-width:500rpx;color:#a8c1bd;font-size:25rpx;line-height:1.8}.primary{border:0;border-radius:22rpx;background:linear-gradient(110deg,#7ce4c2,#5bd5b4);padding:26rpx 19rpx;color:#08251e;font-size:27rpx;font-weight:800}
@keyframes explode{0%{transform:scale(.75);filter:brightness(1)}50%{transform:scale(1.05);filter:brightness(1.9)}100%{transform:scale(1);filter:brightness(1)}}
@media(max-width:390px){.page{padding-left:15rpx;padding-right:15rpx}.grid-frame{width:100%}.board-card{padding-left:8rpx;padding-right:8rpx}.info-row{display:flex;flex-direction:column}.scorebar{padding-left:12rpx;padding-right:12rpx}.avatar{width:59rpx;height:59rpx}.score{font-size:27rpx}}

.board{position:relative}.plane-model{position:absolute;z-index:1;pointer-events:none}.cell-explosion{z-index:2}.cell-wreck{font-size:0}.cell-miss{background:transparent;border:1rpx solid #60827f;box-shadow:inset 0 0 0 4rpx #0b191e}.cell-miss:after{display:none}.rule-icon.hollow{border-radius:3rpx}.result-panel{margin-top:20rpx;padding:24rpx;border:1rpx solid #42786c;border-radius:20rpx;background:#133930}.result-text{font-size:25rpx;line-height:1.7;margin-bottom:20rpx}

.cell-flag{color:#ff5269;font-size:34rpx}
.online-panel{margin-bottom:20rpx;padding:22rpx;border:1rpx solid #25434b;border-radius:24rpx;background:#10252d}.online-controls{display:flex;gap:12rpx;align-items:center;flex-wrap:wrap}.online-controls button{margin:0;font-size:22rpx;line-height:1.5;color:#c7d9d6}.room-input{flex:1;min-width:140rpx;width:160rpx;height:64rpx;padding:0 14rpx;border:1rpx solid #365e5d;border-radius:12rpx;font-size:24rpx}.leave-room{display:inline-block;margin-top:16rpx}
